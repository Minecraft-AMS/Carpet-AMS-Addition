<header>
    <% const view = theme_view(page); %>
    <div class="header-container">
        <a class="site-brand" href="<%- url_for('/') %>" aria-label="Carpet AMS Addition">
            <span>Carpet <strong>AMS</strong> Addition</span>
        </a>
        <nav class="header-menu-list" aria-label="Primary navigation">
            <ul>
            <% for (const item of view.menu) { %>
                <li><%- partial('partial/menu-link', { item }) %></li>
            <% } %>
            </ul>
        </nav>
        <div class="header-controls">
            <div class="segmented-control theme-control" role="group" aria-label="Theme">
                <button type="button" data-set-theme="light" aria-label="浅色模式"><i class="fa-solid fa-sun"></i><span data-i18n-cn="浅色" data-i18n-en="Light">浅色</span></button>
                <button type="button" data-set-theme="dark" aria-label="深色模式"><i class="fa-solid fa-moon"></i><span data-i18n-cn="深色" data-i18n-en="Dark">深色</span></button>
            </div>
            <div class="segmented-control language-control" role="group" aria-label="Language">
                <button type="button" data-set-language="zh-CN" data-language-target="<%- url_for(view.chineseTarget) %>" lang="zh-CN">中文</button>
                <button type="button" data-set-language="en" data-language-target="<%- url_for(view.englishTarget) %>" lang="en">EN</button>
            </div>
        </div>
    </div>
</header>
