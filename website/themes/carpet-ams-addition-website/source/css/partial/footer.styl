.footer-wrapper
    border-top: 1px solid var(--line)

.footer-container
    width: 1280px
    max-width: calc(100% - 64px)
    margin: 0 auto
    padding: 25px 0

.footer-meta
    display: flex
    flex-wrap: wrap
    gap: 8px 18px
    color: var(--muted)
    font-size: 13px

    a
        color: var(--accent)

#top
    position: fixed
    right: 24px
    bottom: 24px
    width: 36px
    height: 36px
    border: 1px solid var(--line)
    background: var(--surface)
    border-radius: 50%
    text-align: center
    line-height: 33px
    opacity: .9

    a
        color: var(--accent)

@media screen and (max-width: 760px)
    .footer-container
        width: calc(100% - 32px)
