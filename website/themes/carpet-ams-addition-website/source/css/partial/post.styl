.article-layout
    position: relative

.article-layout.has-page-toc
    width: calc(100% + 32px)
    display: grid
    grid-template-columns: minmax(0, 860px) minmax(270px, 1fr)
    justify-content: center
    align-items: start
    gap: 64px

    .post-details
        width: 100%
        margin: 0

.page-toc
    position: sticky
    top: 34px
    width: 100%
    align-self: stretch
    max-height: calc(100vh - 68px)
    overflow-y: auto
    padding: 4px 0 4px 20px
    border-left: 1px solid var(--line)

    &[hidden]
        display: none

.page-toc-inner
    .page-toc-title
        margin: 0 0 12px
        color: var(--muted)
        font-size: 11px
        font-weight: 700
        letter-spacing: .12em

    nav
        display: grid
        gap: 2px

    a
        display: block
        padding: 5px 0
        color: var(--muted)
        font-size: 13px
        line-height: 1.45
        text-decoration: none
        transition: color .16s ease

        &:hover, &.is-active
            color: var(--accent)

        &.toc-level-3
            padding-left: 12px
            font-size: 12px

.post-details
    width: min(860px, 100%)
    margin: 0 auto
    padding: 76px 0 96px

    a:not(.nonstyle)
        color: var(--accent)
        border-bottom: 1px solid var(--accent)

    .post-title
        padding-bottom: 26px
        border-bottom: 1px solid var(--line)

        h1
            margin: 0
            font-family: Georgia, "Songti SC", "STSong", serif
            font-size: clamp(34px, 5vw, 55px)
            line-height: 1.14
            letter-spacing: -.04em

    .post-meta
        margin: 14px 0 37px
        color: var(--muted)
        font-size: 13px

    .post-content
        font-size: 17px
        line-height: 1.9

        h1, h2, h3, h4, h5, h6
            margin: 2em 0 .65em
            color: var(--text)
            line-height: 1.25

        h1
            font-size: 1.7em
        h2
            font-size: 1.45em
        h3
            font-size: 1.22em

        p
            margin: 0 0 1.1em

        img
            max-width: 100%
            height: auto

        blockquote
            margin: 1.5em 0
            padding: 8px 20px
            border-left: 3px solid var(--accent)
            background: var(--surface)
            color: var(--muted)

        mark, code:not(.hljs)
            padding: 2px 5px
            border-radius: 3px
            background: var(--code)
            color: var(--accent-strong)
            font-family: "SFMono-Regular", Consolas, monospace
            font-size: .88em

        table
            width: 100%
            border-collapse: collapse
            margin: 1.5em 0
            font-size: .9em

        th, td
            padding: 9px 11px
            border: 1px solid var(--line)
            text-align: center

        th
            background: var(--surface)

    .static-page-content
        padding-top: 34px

    .static-page-content[data-searchable-content]
        padding-top: 18px

        .search-section:first-child > :first-child
            margin-top: 0

    .document-search
        margin-top: 26px

    .search-empty
        margin-bottom: 0

.sr-only
    position: absolute
    width: 1px
    height: 1px
    padding: 0
    margin: -1px
    overflow: hidden
    clip: rect(0, 0, 0, 0)
    white-space: nowrap
    border: 0

@media screen and (max-width: 760px)
    .post-details
        padding: 48px 0 64px

    .post-content
        font-size: 16px

@media screen and (max-width: 1279px)
    .article-layout.has-page-toc
        display: block
        width: 100%

    .page-toc
        display: none
