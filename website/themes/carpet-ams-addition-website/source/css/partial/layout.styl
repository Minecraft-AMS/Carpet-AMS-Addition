.body-container
    min-height: 100vh
    display: flex
    flex-direction: column

.header-wrapper
    border-bottom: 1px solid var(--line)

.main-wrapper
    flex: 1

.main-container
    width: 1280px
    max-width: calc(100% - 64px)
    margin: 0 auto

.eyebrow
    margin: 0 0 14px
    color: var(--accent)
    font-size: 11px
    font-weight: 700
    letter-spacing: .16em

@media screen and (max-width: 760px)
    .main-container
        width: calc(100% - 32px)
