.home-layout
    display: grid
    grid-template-columns: minmax(0, 1fr) 205px
    gap: 64px
    padding: 74px 0 96px

.home-intro
    padding-bottom: 34px
    border-bottom: 1px solid var(--line)

    h1
        margin: 0
        font-family: Georgia, "Songti SC", "STSong", serif
        font-size: clamp(38px, 5vw, 66px)
        line-height: 1.1
        letter-spacing: -.045em

.home-summary
    max-width: 660px
    margin: 17px 0 0
    color: var(--muted)
    font-size: 17px

.release-row
    display: grid
    grid-template-columns: 112px minmax(0, 1fr) auto
    align-items: center
    gap: 20px
    margin: 31px 0 58px
    padding: 16px 20px
    background: var(--surface)
    border-left: 3px solid var(--accent)
    color: var(--muted)

    strong
        color: var(--text)
        font-weight: 600

    &:hover .release-action
        color: var(--accent-strong)

.release-action
    color: var(--accent)
    white-space: nowrap

.section-heading
    display: flex
    justify-content: space-between
    align-items: baseline
    padding-bottom: 13px
    border-bottom: 1px solid var(--line)

    h2
        margin: 0
        font-size: 20px

    > span
        color: var(--muted)
        font-size: 13px

.section-tools
    display: flex
    align-items: center
    gap: 16px

.post-count
    color: var(--muted)
    font-size: 13px
    white-space: nowrap

.content-search
    margin: 18px 0

.compact-search
    margin: 0

    .site-search
        width: clamp(190px, 24vw, 280px)

.site-search
    box-sizing: border-box
    width: min(100%, 360px)
    padding: 10px 12px
    border: 1px solid var(--line)
    border-radius: 5px
    outline: 0
    background: var(--surface)
    color: var(--text)
    font: inherit
    font-size: 14px

    &::placeholder
        color: var(--muted)

    &:focus
        border-color: var(--accent)
        box-shadow: 0 0 0 3px var(--line)

.search-empty
    margin: 22px 0
    color: var(--muted)

.post-item
    display: grid
    grid-template-columns: 130px minmax(0, 1fr)
    align-items: center
    gap: 24px
    min-height: 72px
    border-bottom: 1px solid var(--line)
    transition: padding .15s ease, background-color .15s ease

    &:hover
        padding-left: 12px
        background: var(--surface)

        .post-item-title
            color: var(--accent)

.post-item[hidden]
    display: none

.pagination
    display: grid
    grid-template-columns: 1fr auto 1fr
    align-items: center
    margin-top: 28px
    color: var(--muted)
    font-size: 14px

    a:hover
        color: var(--accent)

.pagination-status
    font-variant-numeric: tabular-nums

.pagination-start, .pagination-end
    display: flex
    gap: 16px

.pagination-end
    justify-content: flex-end

.post-item-date
    color: var(--muted)
    font-size: 13px
    font-variant-numeric: tabular-nums

.post-item-title
    font-size: 17px
    font-weight: 500

.home-aside
    align-self: start
    padding: 11px 0 0 26px
    border-left: 1px solid var(--line)

    h2
        margin: 0 0 15px
        font-size: 14px

    a
        display: block
        padding: 9px 0
        color: var(--muted)
        font-size: 14px

        &:hover
            color: var(--accent)

@media screen and (max-width: 900px)
    .home-layout
        grid-template-columns: 1fr
        gap: 44px
        padding-top: 52px

    .home-aside
        display: flex
        flex-wrap: wrap
        gap: 8px 22px
        padding: 20px 0 0
        border-left: 0
        border-top: 1px solid var(--line)

        h2
            width: 100%

        a
            padding: 0

@media screen and (max-width: 560px)
    .home-layout
        padding: 40px 0 64px

    .home-summary
        font-size: 15px

    .release-row
        grid-template-columns: 1fr auto
        gap: 8px

        strong
            grid-column: 1 / -1
            grid-row: 2

    .post-item
        grid-template-columns: 1fr
        gap: 9px
        padding: 15px 0

    .post-item-date
        grid-column: 1 / -1

    .section-heading
        flex-wrap: wrap
        gap: 12px

    .section-tools
        width: 100%
        justify-content: space-between

    .compact-search
        flex: 1

        .site-search
            width: 100%
