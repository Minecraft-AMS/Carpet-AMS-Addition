.header-container
    width: 1440px
    max-width: calc(100% - 64px)
    min-height: 80px
    margin: 0 auto
    display: flex
    align-items: center
    gap: 34px

.site-brand
    display: inline-flex
    align-items: center
    gap: 10px
    flex: 0 0 auto
    font-size: 18px
    font-weight: 650
    letter-spacing: -.02em
    white-space: nowrap

    strong
        color: var(--accent)
        font-weight: inherit

.header-menu-list
    margin-left: auto

    ul
        display: flex
        align-items: center
        gap: 26px
        list-style: none
        padding: 0
        margin: 0

    a
        color: var(--muted)
        font-size: 14px
        transition: color .15s ease

        &:hover
            color: var(--accent)

.header-controls
    display: flex
    align-items: center
    gap: 10px

.segmented-control
    display: inline-flex
    padding: 2px
    border: 1px solid var(--line)
    border-radius: 7px

    button
        border: 0
        border-radius: 5px
        padding: 5px 8px
        background: transparent
        color: var(--muted)
        cursor: pointer
        font-size: 12px
        line-height: 1.3

        i
            margin-right: 4px

        &.is-active
            background: var(--surface-soft)
            color: var(--accent-strong)

@media screen and (max-width: 1050px)
    .header-container
        width: calc(100% - 32px)
        gap: 18px

    .header-menu-list ul
        gap: 14px

@media screen and (max-width: 800px)
    .header-container
        min-height: auto
        padding: 15px 0
        flex-wrap: wrap

    .header-menu-list
        order: 3
        width: 100%
        overflow-x: auto

        ul
            width: max-content
            gap: 20px

    .header-controls
        margin-left: auto

@media screen and (max-width: 480px)
    .site-brand
        font-size: 16px

    .theme-control span
        display: none
