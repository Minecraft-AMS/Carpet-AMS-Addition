.footer-wrapper
    border-top: 1px solid var(--line)

.footer-container
    width: 1280px
    max-width: calc(100% - 64px)
    margin: 0 auto
    padding: 25px 0

.footer-meta
    display: flex
    flex-wrap: wrap
    gap: 8px 18px
    color: var(--muted)
    font-size: 13px

    a
        color: var(--accent)

.scroll-controls
    position: fixed
    right: 24px
    bottom: calc(24px + env(safe-area-inset-bottom, 0px))
    z-index: 5
    display: flex
    flex-direction: column
    align-items: center

    button
        position: relative
        display: grid
        place-items: center
        width: 38px
        height: 38px
        padding: 0
        border: 0
        border-radius: 7px
        background: transparent
        color: var(--muted)
        opacity: .5
        cursor: pointer
        transition: opacity .18s ease, color .18s ease, transform .18s ease

        &:hover, &:focus-visible
            color: var(--text)
            opacity: 1

        &:focus-visible
            outline: 2px solid var(--accent)
            outline-offset: 2px

        &:active
            transform: scale(.93)

        &::before
            content: attr(aria-label)
            position: absolute
            right: calc(100% + 14px)
            padding: 6px 10px
            border: 1px solid var(--line)
            border-radius: 7px
            background: var(--surface)
            color: var(--text)
            font-size: 12px
            line-height: 1.5
            white-space: nowrap
            pointer-events: none
            opacity: 0
            transform: translateX(4px)
            transition: opacity .18s ease, transform .18s ease

        &:hover::before, &:focus-visible::before
            opacity: 1
            transform: translateX(0)

@media screen and (max-width: 760px)
    .footer-container
        width: calc(100% - 32px)

    .scroll-controls
        right: 16px
        bottom: calc(16px + env(safe-area-inset-bottom, 0px))
