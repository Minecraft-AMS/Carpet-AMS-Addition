.site-effects
    position: fixed
    inset: 0
    width: 100%
    height: 100vh
    height: 100lvh
    pointer-events: none
    -webkit-user-select: none
    user-select: none

.site-effects-background
    z-index: 0
    mask-image: linear-gradient(to right, #000, rgba(0, 0, 0, .22) 28%, rgba(0, 0, 0, .22) 72%, #000)

.site-effects-clicks
    z-index: 2
