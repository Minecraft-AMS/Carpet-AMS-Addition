:root
    --page: #101716
    --surface: #15201e
    --surface-soft: #182321
    --text: #edf3ef
    --muted: #9ba9a4
    --line: #2d3935
    --accent: #78cbbf
    --accent-strong: #b1efe5
    --code: #0c1110
    --code-keyword: #f47067
    --code-number: #6cb6ff
    --code-string: #96d0ff
    --code-title: #dcbdfb
    color-scheme: dark

:root[data-theme='light']
    --page: #f5f4ef
    --surface: #eeefe9
    --surface-soft: #e7e9e2
    --text: #17211e
    --muted: #68746e
    --line: #cfd5cd
    --accent: #1e756b
    --accent-strong: #135d55
    --code: #e1e5dc
    --code-keyword: #a63029
    --code-number: #175e9a
    --code-string: #286747
    --code-title: #684fb0
    color-scheme: light

*
    box-sizing: border-box

[hidden]
    display: none !important

html
    scroll-behavior: smooth
    scrollbar-color: var(--muted) var(--surface)
    scrollbar-width: thin

html::-webkit-scrollbar
    width: 12px

html::-webkit-scrollbar-track
    background: var(--surface)
    border-left: 1px solid var(--line)

html::-webkit-scrollbar-thumb
    min-height: 48px
    background: var(--muted)
    border: 3px solid var(--surface)
    border-radius: 999px

html::-webkit-scrollbar-thumb:hover
    background: var(--accent)

body
    isolation: isolate
    margin: 0
    background: var(--page)
    color: var(--text)
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif
    font-size: 16px
    line-height: 1.6
    transition: background-color .18s ease, color .18s ease

a
    color: inherit
    text-decoration: none

button
    font: inherit

// 以下划线开头的样式文件统一在此合并，不单独生成资源文件。
@import './_partial/layout'
@import './_partial/effects'
@import './_partial/header'
@import './_partial/index'
@import './_partial/footer'
@import './_partial/post'
@import './_partial/highlight'
